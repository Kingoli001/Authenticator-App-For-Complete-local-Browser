  // Renders a formatted code string ("123 456") into individually animated
  // digit cells. Only digits that actually changed roll; unchanged digits
  // and the separating space stay static. Each cell's roll is staggered by
  // its index for a left-to-right wave effect.
  function renderDigits(formatted){
    codeDisplay.classList.remove("placeholder");
    const chars = formatted.split("");

    if (!codeDisplay._cells || codeDisplay._cells.length !== chars.length){
      codeDisplay.innerHTML = "";
      codeDisplay._cells = chars.map(function(ch){
        const cell = document.createElement("span");
        if (ch === " "){
          cell.className = "digit-space";
          cell.textContent = " ";
        } else {
          cell.className = "digit-cell";
          cell.dataset.value = ch;
          cell.innerHTML = '<span class="digit-new">' + ch + "</span>";
        }
        codeDisplay.appendChild(cell);
        return cell;
      });
      return;
    }

    const cells = codeDisplay._cells;
    chars.forEach(function(ch, i){
      const cell = cells[i];
      if (ch === " ") return;
      const prevChar = cell.dataset.value;
      if (prevChar === ch) return;

      const delay = (i * 26) + "ms";
      cell.innerHTML =
        '<span class="digit-old" style="animation-delay:' + delay + '">' + prevChar + "</span>" +
        '<span class="digit-new-anim" style="animation-delay:' + delay + '">' + ch + "</span>";
      cell.dataset.value = ch;

      const settleAfter = 340 + i * 26;
      setTimeout(function(){
        if (cell.dataset.value === ch){
          cell.innerHTML = '<span class="digit-new">' + ch + "</span>";
        }
      }, settleAfter);
    });
  }

  let renderSerial = 0;
  async function render(){
    const serial = ++renderSerial;
    const digits = parseInt(digitsSelect.value, 10) || 6;
    let period = parseInt(periodInput.value, 10);
    if (!period || period < 1) period = 30;
    const type = typeSelect.value === "hotp" ? "hotp" : "totp";
    const algorithm = algorithmSelect.value || "SHA-1";

    const secretBytes = getSecretBytes();
    const remainder = ((currentEpoch % period) + period) % period;
    const remaining = period - remainder;
    const counter = type === "hotp" ? Math.max(0, Number(counterInput.value) || 0) : Math.floor(currentEpoch / period);

    if (!secretBytes){
      showIdleMessage(secretInput.value.trim().length === 0 ? "Waiting for key" : "Press play to generate");
      return;
    }
    secretInput.classList.remove("invalid");

    const code = await otpFromCounter(secretBytes, counter, digits, algorithm);
    if (serial !== renderSerial) return;
    const upcoming = type === "hotp" ? await otpFromCounter(secretBytes, counter + 1, digits, algorithm) : await otpFromCounter(secretBytes, counter + 1, digits, algorithm);
    if (serial !== renderSerial) return;

    if (counter !== lastCounter){
      if (lastCounter !== null) colorIndex = (colorIndex + 1) % RING_COLORS.length;
      lastCounter = counter;
      const c = RING_COLORS[colorIndex];
      ringProgress.style.stroke = c;
      ringProgress.style.filter = "drop-shadow(0 0 5px " + c + "99)";
    }

    if (code !== currentRawCode){ currentRawCode = code; renderDigits(formatCode(code)); }
    nextCode.textContent = formatCode(upcoming);
    currentUpcomingCode = upcoming;

    if (type === "hotp") {
      ringProgress.style.strokeDashoffset = CIRC.toFixed(2);
      ringProgress.classList.remove("pulse");
      codeSub.textContent = "counter " + counter + " · " + algorithm;
    } else if (mode === "live") {
      const pulseThreshold = Math.max(1, Math.min(5, Math.floor(period / 4)));
      ringProgress.style.strokeDashoffset = ringOffsetFor(counter, remainder, period).toFixed(2);
      ringProgress.classList.toggle("pulse", remaining <= pulseThreshold);
      codeSub.textContent = "expires in " + remaining + "s · " + algorithm;
    } else {
      ringProgress.style.strokeDashoffset = ringOffsetFor(counter, remainder, period).toFixed(2);
      ringProgress.classList.remove("pulse");
      const windowStart = new Date((counter*period) * 1000);
      const windowEnd = new Date((counter*period + period) * 1000);
      codeSub.textContent = "valid " + pad2(windowStart.getHours()) + ":" + pad2(windowStart.getMinutes()) + ":" + pad2(windowStart.getSeconds()) +
        " – " + pad2(windowEnd.getHours()) + ":" + pad2(windowEnd.getMinutes()) + ":" + pad2(windowEnd.getSeconds()) + " · " + algorithm;
    }
  }

