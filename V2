      unlockPin.disabled = false;
      lockSubmitBtn.disabled = false;
      return false;
    }

    unlockPin.disabled = true;
    lockSubmitBtn.disabled = true;
    unlockPin.value = '';

    const tick = function(){
      const left = pinLockoutRemainingMs();
      if (left <= 0){
        clearInterval(pinLockoutTimer);
        pinLockoutTimer = null;
        unlockPin.disabled = false;
        lockSubmitBtn.disabled = false;
        lockError.textContent = '';
        unlockPin.focus();
        return;
      }
      lockError.textContent = 'Too many incorrect attempts. Try again in ' + formatLockoutDuration(left) + '.';
    };
    tick();
    pinLockoutTimer = setInterval(tick, 1000);
    return true;
