  const backupPassword = document.getElementById('backupPassword');
  const backupPasswordConfirm = document.getElementById('backupPasswordConfirm');
  const backupPasswordSubmit = document.getElementById('backupPasswordSubmit');
  const backupPasswordError = document.getElementById('backupPasswordError');
  const backupPasswordCancel = document.getElementById('backupPasswordCancel');
  const backupChoicePanel = document.getElementById('backupChoicePanel');
  const chooseEncryptedBackup = document.getElementById('chooseEncryptedBackup');
  const choosePlainBackup = document.getElementById('choosePlainBackup');
  const backupChoiceCancel = document.getElementById('backupChoiceCancel');
  let backupPasswordMode = null;

  const BACKUP_VERSION = 2;
  const BACKUP_ITERATIONS = 250000;

  function openBackup(){
    closeDrawer();
    closeSettings();
    backupStatus.textContent = accounts.length ? (accounts.length + ' account' + (accounts.length === 1 ? '' : 's') + ' ready for backup.') : 'No accounts are currently stored.';
    backupPanel.classList.add('open');
    backupPanel.setAttribute('aria-hidden','false');
  }
  function closeBackup(){
    backupPanel.classList.remove('open');
    backupPanel.setAttribute('aria-hidden','true');
  }
  function setBackupStatus(text, ok){
    backupStatus.textContent = text;
    backupStatus.style.color = ok ? 'var(--amber)' : 'var(--text-dim)';
  }

  function openBackupChoice(){
    backupChoicePanel.classList.add('open');
    backupChoicePanel.setAttribute('aria-hidden','false');
  }
  function closeBackupChoice(){
    backupChoicePanel.classList.remove('open');
    backupChoicePanel.setAttribute('aria-hidden','true');
  }

  function openBackupPassword(mode){
    backupPasswordMode = mode;
    backupPasswordForm.reset();
    backupPasswordError.textContent = '';
    if (mode === 'export'){
      backupPasswordTitle.textContent = 'Encrypt backup';
      backupPasswordDescription.textContent = 'Create a separate password for this backup. It is never stored by the app.';
      backupPasswordConfirm.hidden = false;
      backupPasswordSubmit.textContent = 'ENCRYPT BACKUP';
    } else {
      backupPasswordTitle.textContent = 'Decrypt backup';
      backupPasswordDescription.textContent = 'Enter the password used when this backup was created.';
      backupPasswordConfirm.hidden = true;
      backupPasswordSubmit.textContent = 'RESTORE BACKUP';
    }
    backupPasswordPanel.classList.add('open');
    backupPasswordPanel.setAttribute('aria-hidden','false');
    setTimeout(function(){ backupPassword.focus(); }, 30);
  }
  function closeBackupPassword(){
    backupPasswordPanel.classList.remove('open');
    backupPasswordPanel.setAttribute('aria-hidden','true');
    backupPasswordMode = null;
    backupPassword.value = '';
    backupPasswordConfirm.value = '';
    backupPasswordError.textContent = '';
  }

  async function deriveBackupKey(password, salt, iterations){
    if (!window.crypto || !crypto.subtle) throw new Error('Secure encryption is unavailable in this browser.');
    const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    return crypto.subtle.deriveKey(
      {name:'PBKDF2', salt:salt, iterations:iterations, hash:'SHA-256'},
      material,
      {name:'AES-GCM', length:256},
      false,
      ['encrypt','decrypt']
    );
  }

  async function encryptBackupPayload(password, payload){
    const salt = crypto.getRandomValues(new Uint8Array(16));
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const key = await deriveBackupKey(password, salt, BACKUP_ITERATIONS);
    const plain = new TextEncoder().encode(JSON.stringify(payload));
    const cipher = await crypto.subtle.encrypt({name:'AES-GCM',iv:iv}, key, plain);
    return {
      format:'totp-authenticator-encrypted-backup',
      version:BACKUP_VERSION,
      algorithm:'AES-GCM-256',
      kdf:'PBKDF2-SHA256',
      iterations:BACKUP_ITERATIONS,
      salt:bytesToB64(salt),
      iv:bytesToB64(iv),
      data:bytesToB64(new Uint8Array(cipher))
    };
  }

  async function decryptBackupPayload(password, record){
    if (!record || record.format !== 'totp-authenticator-encrypted-backup' || record.version !== BACKUP_VERSION) throw new Error('Unsupported encrypted backup format.');
    const salt = b64ToBytes(record.salt), iv = b64ToBytes(record.iv), data = b64ToBytes(record.data);
    const iterations = Number(record.iterations) || BACKUP_ITERATIONS;
    const key = await deriveBackupKey(password, salt, iterations);
    let plain;
    try { plain = await crypto.subtle.decrypt({name:'AES-GCM',iv:iv}, key, data); }
    catch(e){ throw new Error('Incorrect backup password or damaged backup.'); }
    const parsed = JSON.parse(new TextDecoder().decode(plain));
    if (!parsed || !Array.isArray(parsed.accounts)) throw new Error('Invalid decrypted backup contents.');
    return parsed;
  }

  drawerBackup.addEventListener('click', openBackup);
  settingsBackup.addEventListener('click', openBackup);
  backupClose.addEventListener('click', closeBackup);
  backupPanel.addEventListener('click', function(e){ if(e.target === backupPanel) closeBackup(); });
  backupPasswordCancel.addEventListener('click', closeBackupPassword);
  backupPasswordPanel.addEventListener('click', function(e){ if(e.target === backupPasswordPanel) closeBackupPassword(); });

  exportBackup.addEventListener('click', function(){
    if (!accounts.length){ setBackupStatus('There are no accounts to export.', false); return; }
    openBackupChoice();
  });

  backupChoiceCancel.addEventListener('click', closeBackupChoice);
  backupChoicePanel.addEventListener('click', function(e){ if(e.target === backupChoicePanel) closeBackupChoice(); });
  chooseEncryptedBackup.addEventListener('click', function(){ closeBackupChoice(); openBackupPassword('export'); });
  choosePlainBackup.addEventListener('click', function(){
    closeBackupChoice();
    const caution = window.confirm('CAUTION\n\nThis backup will contain your TOTP secrets in readable form. Anyone who gets this file may be able to generate your OTP codes.\n\nContinue with an unencrypted backup?');
    if (!caution) return;
    exportPlainBackup();
  });

  async function exportPlainBackup(){
    const payload = {
      format:'totp-authenticator-backup',
      version:1,
      protection:'none',
      exportedAt:new Date().toISOString(),
      accounts:accounts.map(function(a){
        return {id:a.id,name:a.name,secret:a.secret,digits:a.digits,period:a.period,type:a.type||'totp',algorithm:a.algorithm||'SHA-1',counter:Number(a.counter)||0,createdAt:a.createdAt};
      })
    };
    const blob = new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const stamp = new Date().toISOString().replace(/[:.]/g,'-').replace('Z','');
    a.href=url; a.download='authenticator-backup-'+stamp+'.json'; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){URL.revokeObjectURL(url);},1000);
    setBackupStatus('Unencrypted backup exported. Keep the file private.',false);
  }

  importBackup.addEventListener('click', function(){ backupFileInput.value = ''; backupFileInput.click(); });

  backupPasswordForm.addEventListener('submit', async function(e){
    e.preventDefault();
    const pw = backupPassword.value;
    if (pw.length < 8){ backupPasswordError.textContent = 'Use at least 8 characters. Numbers-only passwords are allowed.'; return; }
    if (backupPasswordMode === 'export' && pw !== backupPasswordConfirm.value){ backupPasswordError.textContent = 'Passwords do not match.'; return; }
    backupPasswordSubmit.disabled = true;
    backupPasswordError.textContent = '';
    try{
      if (backupPasswordMode === 'export'){
        const payload = {
          format:'totp-authenticator-backup',
          version:1,
          exportedAt:new Date().toISOString(),
          accounts:accounts.map(function(a){
            return {id:a.id,name:a.name,secret:a.secret,digits:a.digits,period:a.period,type:a.type||'totp',algorithm:a.algorithm||'SHA-1',counter:Number(a.counter)||0,createdAt:a.createdAt};
          })
        };
        const encrypted = await encryptBackupPayload(pw, payload);
        const blob = new Blob([JSON.stringify(encrypted,null,2)],{type:'application/json'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const stamp = new Date().toISOString().replace(/[:.]/g,'-').replace('Z','');
        a.href=url; a.download='authenticator-encrypted-backup-'+stamp+'.json'; document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function(){URL.revokeObjectURL(url);},1000);
        closeBackupPassword();
        setBackupStatus('Encrypted backup exported successfully.',true);
      } else {
        const file = backupFileInput.files && backupFileInput.files[0];
        if (!file) throw new Error('No backup file selected.');
        const data = JSON.parse(await file.text());
        if (data && data.format === 'totp-authenticator-encrypted-backup'){
          const decrypted = await decryptBackupPayload(pw,data);
          const imported = normalizeImportedAccounts(decrypted.accounts);
          closeBackupPassword();
          window.showSafeImportChoice({count:imported.length, encrypted:true, imported:imported});
        } else {
          throw new Error('This is not an encrypted backup.');
        }
      }
    } catch(err){ backupPasswordError.textContent = err.message || 'Backup operation failed.'; }
    finally { backupPasswordSubmit.disabled = false; }
  });

  function normalizeImportedAccounts(list){
    if (!Array.isArray(list)) throw new Error('Backup contains no accounts.');
    return list.map(function(a,index){
      if (!a || typeof a.secret !== 'string' || !a.secret.trim()) throw new Error('Account '+(index+1)+' has no secret.');
      const secret=a.secret.trim().replace(/\s+/g,'').toUpperCase();
      if (!base32Decode(secret).length) throw new Error('Account '+(index+1)+' contains an invalid Base32 secret.');
      return {id:(typeof a.id==='number'||typeof a.id==='string')?a.id:Date.now()+index,name:String(a.name||('Imported account '+(index+1))).trim()||('Imported account '+(index+1)),secret:secret,digits:a.digits===8?8:6,period:Number(a.period)>0?Number(a.period):30,type:(String(a.type||'totp').toLowerCase()==='hotp'?'hotp':'totp'),algorithm:['SHA-1','SHA-256','SHA-512'].includes(String(a.algorithm||'SHA-1').toUpperCase())?String(a.algorithm||'SHA-1').toUpperCase():'SHA-1',counter:Number(a.counter)||0,createdAt:Number(a.createdAt)||Date.now()};
    });
  }
  function applyImportedAccounts(imported, action){
    if (!Array.isArray(imported) || !imported.length) throw new Error('Backup contains no accounts.');
    if (action === 'replace'){
      accounts = imported;
    } else if (action === 'merge'){
      const existingSecrets = new Set(accounts.map(function(a){
        return String(a.secret || '').replace(/\s+/g,'').toUpperCase();
      }));
      imported.forEach(function(a){
        if (existingSecrets.has(a.secret)) return;
        if (accounts.some(function(x){ return x.id === a.id; })){
          a.id = Date.now() + Math.floor(Math.random()*100000);
        }
        a.name = dedupeName(a.name, null);
        accounts.push(a);
        existingSecrets.add(a.secret);
      });
    } else {
      throw new Error('No import action selected.');
    }
    saveAccounts();
    renderAccountList();
  }

  backupFileInput.addEventListener('change', function(){
    const file=this.files&&this.files[0]; if(!file)return;
    file.text().then(function(text){
      let data; try{data=JSON.parse(text);}catch(e){setBackupStatus('Invalid JSON backup.',false);return;}
      if(data && data.format==='totp-authenticator-encrypted-backup'){
        openBackupPassword('import');
      } else if(data && data.format==='totp-authenticator-backup' && data.protection==='none' && Array.isArray(data.accounts)){
        try {
          const imported = normalizeImportedAccounts(data.accounts);
          window.showSafeImportChoice({count:imported.length, encrypted:false, imported:imported});
        } catch(err){ setBackupStatus(err.message || 'Invalid backup.',false); }
      } else {
        setBackupStatus('Unsupported backup format.',false);
      }
    }).catch(function(){setBackupStatus('Could not read the selected file.',false);});
  });

  window.addEventListener('pagehide', function(){ showPrivacyScreen(); });
  window.addEventListener('pageshow', function(){ if(!document.hidden) hidePrivacyScreen(); });

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){
      closeDrawer(); closeSettings(); closeAbout(); closeBackup(); closeBackupChoice();
    }
  });

</script>

<!-- Phase 8.1: explicit import flow -->
<div id="importFlowOverlay" class="import-flow-overlay" hidden>
  <div class="import-flow-modal" role="dialog" aria-modal="true" aria-labelledby="importFlowTitle">
    <div class="import-flow-header">
      <div>
        <div class="import-flow-eyebrow">BACKUP</div>
        <h2 id="importFlowTitle">Import Backup</h2>
      </div>
      <button type="button" class="import-flow-x" id="importFlowX" aria-label="Close">×</button>
    </div>

    <div id="importFlowBody"></div>

    <div class="import-flow-actions" id="importFlowActions"></div>
  </div>
</div>

<style>
.import-flow-overlay{
  position:fixed; inset:0; z-index:9999;
  background:rgba(0,0,0,.72);
  display:flex; align-items:center; justify-content:center;
  padding:18px;
}
.import-flow-overlay[hidden]{display:none}
.import-flow-modal{
  width:min(430px,100%);
  max-height:min(90vh,700px);
  overflow:auto;
  background:var(--panel,#171717);
  color:var(--text,#f5f5f5);
  border:1px solid var(--border,rgba(255,255,255,.12));
  border-radius:18px;
  box-shadow:0 24px 70px rgba(0,0,0,.55);
}
.import-flow-header{
  position:sticky; top:0; z-index:2;
  display:flex; justify-content:space-between; align-items:center;
  padding:18px 18px 14px;
  background:inherit;
  border-bottom:1px solid var(--border,rgba(255,255,255,.1));
}
.import-flow-eyebrow{
  font-size:.68rem; letter-spacing:.14em; opacity:.58; margin-bottom:4px;
}
.import-flow-header h2{margin:0;font-size:1.18rem}
.import-flow-x{
  width:36px;height:36px;border-radius:10px;
  border:1px solid var(--border,rgba(255,255,255,.12));
  background:transparent;color:inherit;font-size:1.35rem;cursor:pointer;
}
.import-flow-content{padding:18px}
.import-flow-type{
  display:flex;gap:12px;align-items:flex-start;
  padding:13px;border-radius:13px;margin-bottom:14px;
  border:1px solid var(--border,rgba(255,255,255,.12));
}
.import-flow-type strong{display:block;margin-bottom:3px}
.import-flow-type small{opacity:.7}
.import-flow-type.secure{border-color:rgba(94,190,125,.35)}
.import-flow-type.warning{border-color:rgba(236,177,63,.5)}
.import-flow-question{font-size:.9rem;line-height:1.45;margin:16px 0 10px}
.import-flow-choice{
  display:flex;align-items:center;gap:12px;
  width:100%;text-align:left;
  padding:14px;border-radius:12px;
  margin:8px 0;border:1px solid var(--border,rgba(255,255,255,.12));
  background:rgba(255,255,255,.025);color:inherit;cursor:pointer;
}
.import-flow-choice:hover,.import-flow-choice.selected{
  border-color:var(--amber,#d9a441);
  background:rgba(217,164,65,.08);
}
.import-flow-choice input{accent-color:var(--amber,#d9a441)}
.import-flow-choice-title{font-weight:700}
.import-flow-choice-desc{font-size:.76rem;opacity:.65;margin-top:3px}
.import-flow-warning{
  padding:13px;border-radius:12px;
  background:rgba(220,105,65,.09);
  border:1px solid rgba(220,105,65,.35);
  line-height:1.45;font-size:.82rem;margin-bottom:14px;
}
.import-flow-actions{
  display:flex;gap:9px;padding:14px 18px 18px;
  border-top:1px solid var(--border,rgba(255,255,255,.1));
  position:sticky;bottom:0;background:inherit;
}
.import-flow-btn{
  flex:1;min-height:44px;border-radius:11px;
  border:1px solid var(--border,rgba(255,255,255,.12));
  background:transparent;color:inherit;font-weight:700;cursor:pointer;
}
.import-flow-btn.primary{background:var(--amber,#d9a441);color:#17120a;border-color:transparent}
.import-flow-btn.danger{background:#9d3d32;color:#fff;border-color:transparent}
.import-flow-btn:disabled{opacity:.4;cursor:not-allowed}
@media(max-width:420px){
  .import-flow-overlay{padding:10px}
  .import-flow-actions{flex-direction:column-reverse}
}
</style>

<script>
(function(){
  "use strict";
  const overlay = document.getElementById("importFlowOverlay");
  const body = document.getElementById("importFlowBody");
  const actions = document.getElementById("importFlowActions");
  const closeBtn = document.getElementById("importFlowX");
  let selected = "";
  let pendingImported = [];
  let pendingEncrypted = false;

  function close(){
    overlay.hidden = true;
    selected = "";
    pendingImported = [];
    pendingEncrypted = false;
  }

  closeBtn.addEventListener("click", close);
  overlay.addEventListener("click", e => { if(e.target === overlay) close(); });

  window.showSafeImportChoice = function(meta){
    pendingImported = Array.isArray(meta.imported) ? meta.imported : [];
    pendingEncrypted = !!meta.encrypted;
    const count = pendingImported.length || Number(meta.count || 0);
    selected = "";

    const typeClass = pendingEncrypted ? "secure" : "warning";
    const icon = pendingEncrypted ? "🔒" : "⚠️";
    const typeTitle = pendingEncrypted ? "Password-protected backup" : "Unencrypted backup";
    const typeDesc = pendingEncrypted
      ? "The backup has been successfully decrypted."
      : "This file contains readable TOTP secrets.";

    body.innerHTML = `
      <div class="import-flow-content">
        <div class="import-flow-type ${typeClass}">
          <div style="font-size:1.35rem">${icon}</div>
          <div>
            <strong>${typeTitle}</strong>
            <small>${typeDesc}</small>
          </div>
        </div>

        ${pendingEncrypted ? "" : `
          <div class="import-flow-warning">
            <strong>Security caution</strong><br>
            This backup contains readable TOTP secrets. Only import a file you trust.
            Anyone who obtains an unencrypted copy may be able to generate your OTP codes.
          </div>
        `}

        <div class="import-flow-question">
          <strong>${count}</strong> account${count===1?"":"s"} found.<br>
          Choose how you want to import them.
        </div>

        <label class="import-flow-choice" data-choice="merge">
          <input type="radio" name="safeImportAction" value="merge">
          <span>
            <div class="import-flow-choice-title">Add to existing accounts</div>
            <div class="import-flow-choice-desc">Keep your current accounts. Duplicate secrets will be skipped.</div>
          </span>
        </label>

        <label class="import-flow-choice" data-choice="replace">
          <input type="radio" name="safeImportAction" value="replace">
          <span>
            <div class="import-flow-choice-title">Replace existing accounts</div>
            <div class="import-flow-choice-desc">Remove your current accounts and use only this backup.</div>
          </span>
        </label>
      </div>`;

    actions.innerHTML = `
      <button type="button" class="import-flow-btn" id="safeImportCancel">Cancel</button>
      <button type="button" class="import-flow-btn primary" id="safeImportContinue" disabled>Continue</button>
    `;

    body.querySelectorAll("[data-choice]").forEach(label => {
      label.addEventListener("click", () => {
        selected = label.dataset.choice;
        body.querySelectorAll("[data-choice]").forEach(x => x.classList.remove("selected"));
        label.classList.add("selected");
        label.querySelector("input").checked = true;
        document.getElementById("safeImportContinue").disabled = false;
      });
    });

    document.getElementById("safeImportCancel").onclick = close;
    document.getElementById("safeImportContinue").onclick = () => {
      if(selected === "replace") showConfirm("replace", count);
      else if(selected === "merge") showConfirm("merge", count);
    };

    overlay.hidden = false;
  };

  function showConfirm(choice, count){
    const replace = choice === "replace";

    body.innerHTML = `
      <div class="import-flow-content">
        <div class="import-flow-type ${replace ? "warning" : "secure"}">
          <div style="font-size:1.35rem">${replace ? "⚠️" : "✓"}</div>
          <div>
            <strong>${replace ? "Replace all accounts?" : "Add backup accounts?"}</strong>
            <small>
              ${replace
                ? `Your current accounts will be removed and replaced by ${count} backup account${count===1?"":"s"}.`
                : `${count} backup account${count===1?"":"s"} will be added. Your current accounts will remain.`}
            </small>
          </div>
        </div>

        ${replace ? `
          <div class="import-flow-warning">
            <strong>This is a destructive action.</strong><br>
            Your current account list will be replaced. Make sure you have a current backup before continuing.
          </div>
        ` : `
          <div class="import-flow-warning" style="background:rgba(94,190,125,.07);border-color:rgba(94,190,125,.25)">
            Existing accounts will remain. Accounts with duplicate TOTP secrets will be skipped.
          </div>
        `}
      </div>`;

    actions.innerHTML = `
      <button type="button" class="import-flow-btn" id="safeImportBack">Go Back</button>
      <button type="button" class="import-flow-btn ${replace ? "danger" : "primary"}" id="safeImportFinal">
        ${replace ? "Replace Accounts" : "Add Accounts"}
      </button>
    `;

    document.getElementById("safeImportBack").onclick = () => {
      window.showSafeImportChoice({
        count: pendingImported.length,
        encrypted: pendingEncrypted,
        imported: pendingImported
      });
    };

    document.getElementById("safeImportFinal").onclick = () => {
      try {
        applyImportedAccounts(pendingImported, choice);
        const n = pendingImported.length;
        close();
        setBackupStatus(
          replace
            ? n + " account" + (n===1?"":"s") + " restored. Existing accounts were replaced."
            : n + " account" + (n===1?"":"s") + " processed. Existing accounts were kept.",
          true
        );
      } catch(err) {
        body.innerHTML = `
          <div class="import-flow-content">
            <div class="import-flow-warning">
              <strong>Import failed</strong><br>${String(err.message || "Could not import backup.")}
            </div>
          </div>`;
        actions.innerHTML = `
          <button type="button" class="import-flow-btn primary" id="safeImportErrorClose">Close</button>`;
        document.getElementById("safeImportErrorClose").onclick = close;
      }
    };
  }

  window.safeImportFlow = { open: window.showSafeImportChoice, close };
})();
</script>

