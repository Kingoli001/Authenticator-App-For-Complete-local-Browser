  // easy to transcribe by hand. Dashes/case are cosmetic — canonicalize
  // before ever using the code as key material, so formatting differences
  // at entry time never cause a false mismatch.
  function randomRecoveryCode(){
    const alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
