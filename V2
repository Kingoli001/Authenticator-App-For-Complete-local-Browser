  // Alternates direction each window: even counters drain (full -> empty),
  // odd counters fill (empty -> full). Consecutive windows always meet at the
  // same offset, so the ring never snaps/rebounds back to a start point —
  // each new color just continues from exactly where the last one ended.
  function ringOffsetFor(counter, remainder, period){
    const frac = remainder / period;
    return (counter % 2 === 0) ? CIRC * frac : CIRC * (1 - frac);
  }

