  async function liveScanTick(){
    if (!liveScanning) return;
    if (scanVideo.readyState === scanVideo.HAVE_ENOUGH_DATA){
      try{
        if (liveDetector){
          const results = await liveDetector.detect(scanVideo);
          if (results && results.length > 0 && results[0].rawValue){
            stopLiveScan();
            handleScanResult(results[0].rawValue);
            return;
          }
        } else if (typeof jsQR === "function"){
          scanCanvas.width = scanVideo.videoWidth;
          scanCanvas.height = scanVideo.videoHeight;
          const ctx = scanCanvas.getContext("2d");
          ctx.drawImage(scanVideo, 0, 0, scanCanvas.width, scanCanvas.height);
          const imageData = ctx.getImageData(0, 0, scanCanvas.width, scanCanvas.height);
          const result = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: "attemptBoth" });
          if (result && result.data){
            stopLiveScan();
            handleScanResult(result.data);
            return;
          }
        }
      } catch(e){ /* keep trying on next frame */ }
    }
    liveRAF = requestAnimationFrame(liveScanTick);
  }

  async function startLiveScan(facing){
    stopLiveScan();
    liveFacing = facing;
    try{
      liveStream = await navigator.mediaDevices.getUserMedia({
