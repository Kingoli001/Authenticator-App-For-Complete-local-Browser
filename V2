  let torchOn = false;

  function stopLiveScan(){
    liveScanning = false;
    if (liveRAF) cancelAnimationFrame(liveRAF);
    liveRAF = null;
    if (liveStream){
      liveStream.getTracks().forEach(function(t){ t.stop(); });
      liveStream = null;
    }
    liveTrack = null;
