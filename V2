      scanStatus.hidden = true;
      scanBtn.classList.add("active");
      liveScanning = true;
      liveRAF = requestAnimationFrame(liveScanTick);
    } catch(err){
      stopLiveScan();
      // Every live-scan avenue failed (denied permission, no camera,
