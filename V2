<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Code Instrument — TOTP / HOTP Authenticator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsqr/1.4.0/jsQR.js"></script>
<style>
  :root{
    --bg:#10141b;
    --panel:#1b212b;
    --panel-2:#212938;
    --border:#2c3444;
    --text:#edeae4;
    --text-dim:#8991a3;
    --amber:#f2a93b;
    --amber-dim:rgba(242,169,59,0.16);
    --teal:#4fb6a6;
    --teal-dim:rgba(79,182,166,0.16);
    --danger:#e2574c;
    --danger-dim:rgba(226,87,76,0.16);
    --ring-circumference: 565.48;
  }

  *{box-sizing:border-box;}
  [hidden]{ display:none !important; }

  html,body{
    margin:0;
    min-height:100%;
    background:
      radial-gradient(circle at 50% -10%, rgba(242,169,59,0.06), transparent 55%),
      var(--bg);
    background-image:
      radial-gradient(circle at 50% -10%, rgba(242,169,59,0.06), transparent 55%),
      linear-gradient(rgba(255,255,255,0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.028) 1px, transparent 1px),
      var(--bg);
    background-size: auto, 28px 28px, 28px 28px, auto;
    color:var(--text);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
  }

  .stage{
    min-height:100vh;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:2.25rem 1rem 3rem;
  }

  .card{
    width:min(94vw, 440px);
    background:linear-gradient(180deg, var(--panel-2), var(--panel));
    border:1px solid var(--border);
    border-radius:20px;
    padding:1.5rem 1.5rem 1.25rem;
    box-shadow: 0 30px 60px -25px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02) inset;
    position:relative;
    overflow:hidden;
  }
  .card::before{
    content:"";
    position:absolute;
    top:-40%; left:-20%;
    width:70%; height:70%;
    background:radial-gradient(circle, rgba(242,169,59,0.08), transparent 70%);
    pointer-events:none;
  }

  .card-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:0.75rem;
    position:relative;
  }

  .eyebrow{
    font-size:0.66rem;
    letter-spacing:0.14em;
    color:var(--text-dim);
    font-weight:600;
    text-transform:uppercase;
  }

  .mode-pill{
    display:flex;
    align-items:center;
    gap:0.4rem;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.68rem;
    letter-spacing:0.08em;
    font-weight:600;
    padding:0.28rem 0.6rem;
    border-radius:999px;
    border:1px solid var(--border);
    background:rgba(255,255,255,0.02);
    color:var(--danger);
    transition:color .25s ease, border-color .25s ease;
  }
  .mode-pill .dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--danger);
    box-shadow:0 0 8px 1px var(--danger);
    animation:pulse 1.6s ease-in-out infinite;
  }
  .mode-pill.custom{ color:var(--teal); border-color:rgba(79,182,166,0.35); }
  .mode-pill.custom .dot{ background:var(--teal); box-shadow:0 0 8px 1px var(--teal); animation:none; }
  .mode-pill.idle{ color:var(--text-dim); border-color:var(--border); }
  .mode-pill.idle .dot{ background:var(--text-dim); box-shadow:none; animation:none; }

  @keyframes pulse{
    0%,100%{ opacity:1; }
    50%{ opacity:0.35; }
  }

  .title{
    margin:0.6rem 0 1.3rem;
    font-size:1.5rem;
    font-weight:700;
    letter-spacing:-0.01em;
  }

  .field{ display:flex; flex-direction:column; gap:0.4rem; margin-bottom:0.9rem; }
  .field-label{ font-size:0.72rem; color:var(--text-dim); font-weight:600; letter-spacing:0.03em; }
  .field-hint{ font-size:0.7rem; color:var(--text-dim); line-height:1.4; }

  .scan-result{
    margin:0.45rem 0 0;
    font-size:0.74rem;
    color:var(--teal);
    background:var(--teal-dim);
    border:1px solid rgba(79,182,166,0.35);
    border-radius:8px;
    padding:0.4rem 0.6rem;
    display:flex;
    align-items:center;
    gap:0.4rem;
  }

  .secret-row{ display:flex; gap:0.5rem; }
  .secret-row input{ flex:1; }
  .play-btn{
    flex-shrink:0;
    width:44px;
    background:var(--amber);
    color:#1a1305;
    border:none;
    border-radius:10px;
    font-size:0.95rem;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:filter .15s ease, transform .1s ease, background .2s ease, color .2s ease;
  }
  .play-btn:hover:not(:disabled){ filter:brightness(1.08); }
  .play-btn:active:not(:disabled){ transform:translateY(1px); }
  .play-btn:disabled{ background:var(--border); color:var(--text-dim); cursor:not-allowed; }

  input[type="text"], input[type="number"], input[type="datetime-local"], select{
    font-family:'IBM Plex Mono', monospace;
    background:rgba(0,0,0,0.22);
    border:1px solid var(--border);
    border-radius:10px;
    color:var(--text);
    padding:0.65rem 0.75rem;
    font-size:0.92rem;
    outline:none;
    width:100%;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  input::placeholder{ color:#565f70; }
  input:focus, select:focus{
    border-color:var(--amber);
    box-shadow:0 0 0 3px var(--amber-dim);
  }
  input[type="text"].invalid{
    border-color:var(--danger);
    box-shadow:0 0 0 3px var(--danger-dim);
  }

  details.advanced{
    margin-bottom:0.9rem;
    border:1px solid var(--border);
    border-radius:10px;
    background:rgba(0,0,0,0.12);
    padding:0.15rem 0.75rem;
  }
  details.advanced summary{
    cursor:pointer;
    font-size:0.75rem;
    color:var(--text-dim);
    font-weight:600;
    letter-spacing:0.03em;
    padding:0.55rem 0;
    list-style:none;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  details.advanced summary::-webkit-details-marker{ display:none; }
  details.advanced summary::after{
    content:"+";
    font-size:1rem;
    color:var(--text-dim);
  }
  details.advanced[open] summary::after{ content:"−"; }
  .advanced-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:0.75rem;
    padding-bottom:0.85rem;
  }
  .field-sm{ display:flex; flex-direction:column; gap:0.35rem; }
  .field-sm .field-label{ font-size:0.68rem; }

  .datetime-row{ display:flex; gap:0.6rem; align-items:flex-end; margin-bottom:1.1rem; }
  .datetime-row .field{ flex:1; margin-bottom:0; }
  .now-btn{
    font-family:'IBM Plex Mono', monospace;
    font-weight:600;
    font-size:0.82rem;
    letter-spacing:0.03em;
    background:var(--amber);
    color:#1a1305;
    border:none;
    border-radius:10px;
    padding:0.65rem 0.9rem;
    cursor:pointer;
    transition:background .2s ease, filter .15s ease, transform .1s ease;
    white-space:nowrap;
  }
  .now-btn:hover{ filter:brightness(1.08); }
  .now-btn:active{ transform:translateY(1px); }

  .dial-wrap{
    position:relative;
    width:min(72vw, 250px);
    aspect-ratio:1/1;
    margin:0.4rem auto 1.1rem;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .dial-ring{ width:100%; height:100%; transform:rotate(-90deg); }
  .ring-track{
    fill:none;
    stroke:rgba(255,255,255,0.06);
    stroke-width:5;
  }
  .ring-progress{
    fill:none;
    stroke:var(--amber);
    stroke-width:5;
    stroke-linecap:round;
    stroke-dasharray: var(--ring-circumference);
    stroke-dashoffset:0;
    transition:stroke-dashoffset 1s linear, stroke .3s ease;
    filter:drop-shadow(0 0 5px rgba(242,169,59,0.55));
  }
  .ring-progress.pulse{ animation:ringPulse 1s ease-in-out infinite; }
  .ring-progress.custom{ transition:none; }
  @keyframes ringPulse{
    0%,100%{ opacity:1; }
    50%{ opacity:0.55; }
  }
  .tick{ stroke:rgba(255,255,255,0.14); stroke-width:1.5; }

  .dial-center{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:0 1rem;
  }
  .code-display{
    font-family:'IBM Plex Mono', monospace;
    font-weight:600;
    font-size:clamp(1.55rem, 6.5vw, 2rem);
    letter-spacing:0.04em;
    font-variant-numeric:tabular-nums;
    color:var(--text);
    display:inline-flex;
    align-items:flex-start;
  }
  .code-display.placeholder{
    display:block;
    font-family:'IBM Plex Sans', sans-serif;
    font-weight:600;
    font-size:clamp(0.82rem, 4vw, 0.98rem);
    letter-spacing:0.01em;
    color:var(--text-dim);
    white-space:normal;
    line-height:1.35;
  }
  .digit-cell{
    position:relative;
    display:inline-block;
    overflow:hidden;
    height:1.15em;
    line-height:1.15em;
    min-width:0.6em;
    text-align:center;
  }
  .digit-space{
    display:inline-block;
    width:0.5em;
  }
  .digit-old, .digit-new-anim{
    position:absolute;
    left:0; right:0; top:0;
    line-height:1.15em;
  }
  .digit-old{ animation: rollOut .34s cubic-bezier(.4,0,.2,1) forwards; }
  .digit-new-anim{ animation: rollIn .34s cubic-bezier(.4,0,.2,1) forwards; }
  @keyframes rollOut{
    0%{ transform:translateY(0); opacity:1; filter:blur(0); }
    55%{ filter:blur(1.5px); }
    100%{ transform:translateY(-100%); opacity:0; filter:blur(0); }
  }
  @keyframes rollIn{
    0%{ transform:translateY(100%); opacity:0; filter:blur(1.5px); }
    55%{ filter:blur(1.5px); }
    100%{ transform:translateY(0); opacity:1; filter:blur(0); }
  }
  .code-sub{
    margin-top:0.4rem;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.68rem;
    color:var(--text-dim);
    letter-spacing:0.02em;
    line-height:1.35;
  }

  .next-row{
    display:flex;
    align-items:center;
    gap:0.55rem;
    background:rgba(0,0,0,0.18);
    border:1px solid var(--border);
    border-radius:12px;
    padding:0.55rem 0.7rem;
  }
  .next-label{
    font-size:0.64rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--text-dim);
    font-weight:600;
  }
  .next-code{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.9rem;
    color:#c9cedb;
    letter-spacing:0.03em;
    font-variant-numeric:tabular-nums;
    flex:1;
    cursor:pointer;
    user-select:none;
    -webkit-user-select:none;
    transition:color .15s ease;
  }
  .next-code:hover{ color:var(--amber); }
  .next-code:active{ opacity:0.7; }
  .code-display{ cursor:pointer; user-select:none; -webkit-user-select:none; touch-action:manipulation; transition:transform .1s ease, opacity .1s ease; }
  .code-display.pressing{ transform:scale(0.96); opacity:0.75; }

  .copy-toast{
    margin:0.55rem 0 0;
    text-align:center;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.74rem;
    font-weight:600;
    letter-spacing:0.04em;
    color:var(--teal);
    background:var(--teal-dim);
    border:1px solid rgba(79,182,166,0.35);
    border-radius:8px;
    padding:0.35rem 0.6rem;
    animation:toastPop .18s ease;
  }
  @keyframes toastPop{
    0%{ opacity:0; transform:translateY(-4px); }
    100%{ opacity:1; transform:translateY(0); }
  }

  .footnote{
    margin:1rem 0 0;
    font-size:0.66rem;
    color:#5b6272;
    text-align:center;
    line-height:1.5;
  }

  .gen-link{
    background:none; border:none; padding:0;
    color:var(--text-dim);
    text-decoration:underline;
    text-decoration-color:var(--border);
    font-size:0.7rem;
    cursor:pointer;
    font-family:'IBM Plex Sans', sans-serif;
  }
  .gen-link:hover{ color:var(--amber); text-decoration-color:var(--amber); }

  .scan-btn{
    flex-shrink:0;
    width:44px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,0.03);
    border:1px solid var(--border);
    color:var(--text);
    border-radius:10px;
    cursor:pointer;
    transition:border-color .15s ease, color .15s ease, background .15s ease;
  }
  .scan-btn:hover{ border-color:var(--amber); color:var(--amber); background:var(--amber-dim); }
  .scan-btn.active{ border-color:var(--amber); color:var(--amber); background:var(--amber-dim); }

  .scan-inline{
    margin-top:0.7rem;
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .scan-viewport{
    position:relative;
    width:100%;
    max-width:230px;
    aspect-ratio:1/1;
    border-radius:14px;
    overflow:hidden;
    background:#000;
  }
  .scan-viewport video{
    width:100%; height:100%;
    object-fit:cover;
    display:block;
  }
  .scan-frame{
    position:absolute;
    inset:12%;
    border:2px solid rgba(242,169,59,0.85);
    border-radius:12px;
    box-shadow:0 0 0 999px rgba(0,0,0,0.35);
    overflow:hidden;
  }
  .scan-line{
    position:absolute;
    left:0; right:0; top:0;
    height:2px;
    background:linear-gradient(90deg, transparent, var(--amber), transparent);
    box-shadow:0 0 8px 1px var(--amber);
    animation:scanSweep 2.2s ease-in-out infinite;
  }
  @keyframes scanSweep{
    0%{ top:2%; }
    50%{ top:96%; }
    100%{ top:2%; }
  }
  .flip-btn{
    position:absolute;
    top:8px; right:8px;
    width:34px; height:34px;
    border-radius:50%;
    background:rgba(0,0,0,0.55);
    border:1px solid rgba(255,255,255,0.3);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    transition:border-color .15s ease, transform .15s ease;
  }
  .flip-btn:hover{ border-color:var(--amber); }
  .flip-btn:active{ transform:scale(0.92); }
  .flip-btn svg{ width:17px; height:17px; }

  .scan-status{
    margin:0.5rem 0 0;
    font-size:0.74rem;
    color:var(--text-dim);
    text-align:left;
    line-height:1.4;
  }

  @media (prefers-reduced-motion: reduce){
    .ring-progress{ transition:none; }
    .digit-old, .digit-new-anim{ animation:none; }
    .mode-pill .dot{ animation:none; }
    .scan-line{ animation:none; top:50%; }
  }

  /* ---------- List screen ---------- */
  /* ---------- Hamburger navigation drawer ---------- */
  .menu-btn{
    width:38px;height:38px;border-radius:10px;border:1px solid var(--border);
    background:rgba(255,255,255,0.02);color:var(--text);display:flex;
    align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;
    transition:border-color .2s ease,background .2s ease,color .2s ease;
  }
  .menu-btn:hover{border-color:var(--amber);color:var(--amber);background:var(--amber-dim)}
  .menu-btn svg{width:19px;height:19px}
  .drawer-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,.58);z-index:90;
    opacity:0;visibility:hidden;transition:opacity .22s ease,visibility .22s ease;
    backdrop-filter:blur(2px);
  }
  .drawer-overlay.open{opacity:1;visibility:visible}
  .nav-drawer{
    position:fixed;left:0;top:0;bottom:0;width:min(310px,86vw);z-index:100;
    background:var(--panel);border-right:1px solid var(--border);
    box-shadow:18px 0 45px rgba(0,0,0,.35);transform:translateX(-102%);
    transition:transform .26s cubic-bezier(.22,.61,.36,1);display:flex;flex-direction:column;
    padding:1rem .85rem;
  }
  .nav-drawer.open{transform:translateX(0)}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;padding:.25rem .25rem 1rem;border-bottom:1px solid var(--border)}
  .drawer-brand{display:flex;align-items:center;gap:.65rem}
  .drawer-logo{width:36px;height:36px;border-radius:10px;background:var(--amber);color:#1a1305;display:flex;align-items:center;justify-content:center;font-weight:800}
  .drawer-brand strong{font-size:.9rem;letter-spacing:.02em}.drawer-brand span{display:block;color:var(--text-dim);font-size:.66rem;margin-top:.12rem}
  .drawer-close{width:34px;height:34px;border-radius:9px;border:1px solid var(--border);background:transparent;color:var(--text);font-size:1.25rem;cursor:pointer}
  .drawer-close:hover{border-color:var(--amber);color:var(--amber)}
  .drawer-section{padding:.95rem .25rem 0}.drawer-label{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:var(--text-dim);font-weight:700;margin:0 .65rem .45rem}
  .drawer-item{width:100%;display:flex;align-items:center;gap:.75rem;border:1px solid transparent;background:transparent;color:var(--text);padding:.72rem .65rem;border-radius:10px;font:600 .82rem 'IBM Plex Sans',sans-serif;text-align:left;cursor:pointer;transition:.16s ease}
  .drawer-item:hover,.drawer-item.active{background:var(--amber-dim);border-color:rgba(242,169,59,.22);color:var(--amber)}
  .drawer-item svg{width:18px;height:18px;flex-shrink:0}.drawer-footer{margin-top:auto;border-top:1px solid var(--border);padding:.8rem .65rem;color:var(--text-dim);font-size:.64rem;line-height:1.5}
  .drawer-footer b{color:var(--text)}
  .settings-panel{position:fixed;inset:0;z-index:110;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.58);opacity:0;visibility:hidden;transition:.2s ease}
  .settings-panel.open{opacity:1;visibility:visible}.settings-card{width:min(520px,100%);max-height:90dvh;overflow-y:auto;overscroll-behavior:contain;background:var(--panel);border:1px solid var(--border);border-bottom:none;border-radius:18px 18px 0 0;padding:1rem 1rem 1.25rem;transform:translateY(20px);transition:.22s ease;box-sizing:border-box}.settings-card::-webkit-scrollbar{width:5px}.settings-card::-webkit-scrollbar-thumb{background:rgba(255,255,255,.16);border-radius:10px}
  .settings-panel.open .settings-card{transform:translateY(0)}.settings-head{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;margin:0 0 .8rem;padding:.05rem 0 .8rem;background:var(--panel);border-bottom:1px solid var(--border)}.settings-head h2{font-size:1rem}.settings-row{display:flex;align-items:center;justify-content:space-between;padding:.85rem 0;border-bottom:1px solid var(--border);font-size:.82rem}.settings-row small{display:block;color:var(--text-dim);margin-top:.2rem;font-size:.67rem}
  .theme-toggle{width:42px;height:24px;border-radius:99px;border:1px solid var(--border);background:rgba(255,255,255,.06);position:relative;cursor:pointer}.theme-toggle:after{content:"";position:absolute;width:18px;height:18px;border-radius:50%;background:var(--text-dim);left:2px;top:2px;transition:.2s}.theme-toggle.on{background:var(--amber-dim);border-color:rgba(242,169,59,.4)}.theme-toggle.on:after{left:20px;background:var(--amber)}
  .about-panel{position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center;padding:1rem;background:rgba(0,0,0,.58);opacity:0;visibility:hidden;transition:.2s ease}.about-panel.open{opacity:1;visibility:visible}.about-card{width:min(390px,100%);background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:1.25rem;text-align:center}.about-card .drawer-logo{margin:0 auto .7rem}.about-card h2{font-size:1rem;margin-bottom:.3rem}.about-card p{color:var(--text-dim);font-size:.72rem;line-height:1.55}
  .about-close-btn{width:100%;height:44px;margin-top:1.1rem;border:0;border-radius:10px;background:var(--amber);color:#1a1305;font:700 .8rem 'IBM Plex Sans',sans-serif;cursor:pointer}
  .about-close-btn:hover{filter:brightness(1.06)}
  .about-meta{margin-top:.9rem;padding-top:.9rem;border-top:1px solid var(--border)}
  .about-meta p{margin:.22rem 0;font-size:.68rem}
  .about-meta p b{color:var(--text)}
  .about-copyright{margin-top:.5rem !important;color:var(--text-dim);opacity:.8}

  /* ---------- Backup / restore (Phase 3) ---------- */
  .backup-panel{position:fixed;inset:0;z-index:115;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.58);opacity:0;visibility:hidden;transition:.2s ease}
  .backup-panel.open{opacity:1;visibility:visible}
  .backup-card{width:min(520px,100%);background:var(--panel);border:1px solid var(--border);border-bottom:none;border-radius:18px 18px 0 0;padding:1rem 1rem 1.25rem;transform:translateY(20px);transition:.22s ease;box-shadow:0 -18px 50px rgba(0,0,0,.3)}
  .backup-panel.open .backup-card{transform:translateY(0)}
  .backup-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem}.backup-head h2{font-size:1rem}
