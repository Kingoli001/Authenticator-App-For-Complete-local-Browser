<script>
  "use strict";

  /* ---------- SHA-1 (pure JS, no dependency on Web Crypto) ---------- */
  function rotl(n, s){ return ((n << s) | (n >>> (32 - s))) >>> 0; }

  function sha1(bytes){
    const msgLen = bytes.length;
    const bitLen = msgLen * 8;
    const totalLen = (((msgLen + 9 + 63) >> 6) << 6);
    const padded = new Uint8Array(totalLen);
    padded.set(bytes);
    padded[msgLen] = 0x80;
    const dv = new DataView(padded.buffer);
    const lenPos = totalLen - 8;
    dv.setUint32(lenPos, Math.floor(bitLen / 0x100000000), false);
    dv.setUint32(lenPos + 4, bitLen >>> 0, false);

    let h0=0x67452301, h1=0xEFCDAB89, h2=0x98BADCFE, h3=0x10325476, h4=0xC3D2E1F0;
    const w = new Uint32Array(80);

    for (let chunk=0; chunk<totalLen; chunk+=64){
      for (let i=0;i<16;i++) w[i] = dv.getUint32(chunk + i*4, false);
      for (let i=16;i<80;i++) w[i] = rotl(w[i-3]^w[i-8]^w[i-14]^w[i-16], 1);

      let a=h0,b=h1,c=h2,d=h3,e=h4;
      for (let i=0;i<80;i++){
        let f,k;
        if (i<20){ f=(b&c)|((~b)&d); k=0x5A827999; }
        else if (i<40){ f=b^c^d; k=0x6ED9EBA1; }
        else if (i<60){ f=(b&c)|(b&d)|(c&d); k=0x8F1BBCDC; }
        else { f=b^c^d; k=0xCA62C1D6; }
        const temp = (rotl(a,5) + f + e + k + w[i]) >>> 0;
        e=d; d=c; c=rotl(b,30); b=a; a=temp;
      }
      h0=(h0+a)>>>0; h1=(h1+b)>>>0; h2=(h2+c)>>>0; h3=(h3+d)>>>0; h4=(h4+e)>>>0;
    }

    const out = new Uint8Array(20);
    const odv = new DataView(out.buffer);
    odv.setUint32(0,h0,false); odv.setUint32(4,h1,false); odv.setUint32(8,h2,false);
    odv.setUint32(12,h3,false); odv.setUint32(16,h4,false);
    return out;
  }

  function hmacSha1(key, message){
    const blockSize = 64;
    let k = key;
    if (k.length > blockSize) k = sha1(k);
    const padded = new Uint8Array(blockSize);
    padded.set(k);
    const ipad = new Uint8Array(blockSize);
    const opad = new Uint8Array(blockSize);
    for (let i=0;i<blockSize;i++){
      ipad[i] = padded[i] ^ 0x36;
      opad[i] = padded[i] ^ 0x5c;
    }
    const inner = new Uint8Array(blockSize + message.length);
    inner.set(ipad); inner.set(message, blockSize);
    const innerHash = sha1(inner);
    const outer = new Uint8Array(blockSize + 20);
    outer.set(opad); outer.set(innerHash, blockSize);
    return sha1(outer);
  }

  /* ---------- Base32 ---------- */
  function base32Decode(input){
    const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
    const clean = input.toUpperCase().replace(/[^A-Z2-7]/g, "");
    let bits = "";
    for (const c of clean){
      const val = alphabet.indexOf(c);
      if (val === -1) continue;
      bits += val.toString(2).padStart(5, "0");
    }
    const bytes = [];
    for (let i=0; i+8<=bits.length; i+=8){
      bytes.push(parseInt(bits.substr(i,8), 2));
    }
    return new Uint8Array(bytes);
  }

  /* ---------- TOTP ---------- */
  function counterToBytes(counter){
    const buf = new Uint8Array(8);
    const dv = new DataView(buf.buffer);
    const high = Math.floor(counter / 0x100000000);
    const low = counter % 0x100000000;
    dv.setUint32(0, high, false);
    dv.setUint32(4, low, false);
    return buf;
  }

  function totpFromCounter(secretBytes, counter, digits){
    const hash = hmacSha1(secretBytes, counterToBytes(counter));
    const offset = hash[19] & 0xf;
    const binCode = ((hash[offset] & 0x7f) << 24) |
                     ((hash[offset+1] & 0xff) << 16) |
                     ((hash[offset+2] & 0xff) << 8) |
                     (hash[offset+3] & 0xff);
    const otp = binCode % Math.pow(10, digits);
    return otp.toString().padStart(digits, "0");
  }

  async function hmacWebCrypto(keyBytes, messageBytes, algorithm){
    const key = await crypto.subtle.importKey("raw", keyBytes, {name:"HMAC", hash:{name:algorithm}}, false, ["sign"]);
    return new Uint8Array(await crypto.subtle.sign("HMAC", key, messageBytes));
  }

  async function otpFromCounter(secretBytes, counter, digits, algorithm){
    const alg = (algorithm || "SHA-1").toUpperCase();
    const hash = alg === "SHA-1" ? hmacSha1(secretBytes, counterToBytes(counter)) : await hmacWebCrypto(secretBytes, counterToBytes(counter), alg);
    const offset = hash[hash.length - 1] & 0x0f;
    const binCode = ((hash[offset] & 0x7f) << 24) |
                    ((hash[offset+1] & 0xff) << 16) |
                    ((hash[offset+2] & 0xff) << 8) |
                    (hash[offset+3] & 0xff);
    return (binCode % Math.pow(10, digits)).toString().padStart(digits, "0");
  }

  async function generateOtp(account, nowMs){
    const secretBytes = base32Decode(account.secret || "");
    if (!secretBytes.length) return null;
    const digits = account.digits === 8 ? 8 : 6;
    const algorithm = account.algorithm || "SHA-1";
    const type = (account.type || "totp").toLowerCase();
    if (type === "hotp") {
      const counter = Math.max(0, Number(account.counter) || 0);
      return {code: await otpFromCounter(secretBytes, counter, digits, algorithm), remaining:null, period:null, counter:counter};
    }
    const period = Number(account.period) > 0 ? Number(account.period) : 30;
    const nowSec = Math.floor((nowMs == null ? Date.now() : nowMs) / 1000);
    const counter = Math.floor(nowSec / period);
    const remaining = period - (((nowSec % period) + period) % period);
    return {code: await otpFromCounter(secretBytes, counter, digits, algorithm), remaining:remaining, period:period, counter:counter};
  }

  function formatCode(code){
    if (code.length === 6) return code.slice(0,3) + " " + code.slice(3);
    if (code.length === 8) return code.slice(0,4) + " " + code.slice(4);
    return code;
  }

