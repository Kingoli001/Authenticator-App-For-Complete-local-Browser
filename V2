  function clearPinAttempts(){
    localStorage.removeItem(PIN_ATTEMPTS_KEY);
  }
  function registerFailedPinAttempt(){
    const state = readPinAttempts();
    state.count += 1;
    if (state.count >= PIN_ATTEMPT_THRESHOLD){
      const duration = PIN_LOCKOUT_STAGES_MS[Math.min(state.stage, PIN_LOCKOUT_STAGES_MS.length - 1)];
      state.lockedUntil = Date.now() + duration;
      state.stage += 1;
      state.count = 0;
    }
    writePinAttempts(state);
    return state;
  }
  function pinLockoutRemainingMs(){
    const remaining = readPinAttempts().lockedUntil - Date.now();
    return remaining > 0 ? remaining : 0;
  }
  function formatLockoutDuration(ms){
    const totalSeconds = Math.max(1, Math.ceil(ms / 1000));
    if (totalSeconds < 60) return totalSeconds + (totalSeconds === 1 ? ' second' : ' seconds');
    const mins = Math.ceil(totalSeconds / 60);
    return mins + (mins === 1 ? ' minute' : ' minutes');
  }

  let pinLockoutTimer = null;
  function applyPinLockoutUI(){
    const remaining = pinLockoutRemainingMs();
    if (pinLockoutTimer) { clearInterval(pinLockoutTimer); pinLockoutTimer = null; }

