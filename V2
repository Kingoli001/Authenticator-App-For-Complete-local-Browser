  /* ---------- PIN attempt rate-limiting ----------
     Tracked in localStorage (not memory) so a page reload can't be used
     to reset the counter. Applies to any flow that verifies an existing
     PIN against the stored hash: unlocking, and confirming the current
     PIN before changing or disabling it. */
  function readPinAttempts(){
    try {
      const raw = localStorage.getItem(PIN_ATTEMPTS_KEY);
      if (!raw) return { count: 0, stage: 0, lockedUntil: 0 };
      const parsed = JSON.parse(raw);
      return {
        count: Number(parsed.count) || 0,
        stage: Number(parsed.stage) || 0,
        lockedUntil: Number(parsed.lockedUntil) || 0
      };
    } catch(e){ return { count: 0, stage: 0, lockedUntil: 0 }; }
  }
  function writePinAttempts(state){
    localStorage.setItem(PIN_ATTEMPTS_KEY, JSON.stringify(state));
