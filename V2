  // Swipe left or right on a card to delete it (with the same undo safety
  // net as the explicit delete button). A vertical touch is left alone so
  // normal list scrolling is never interrupted.
  function attachSwipeToDelete(card, wrap, accountId){
    const threshold = 88;
    const maxDrag = 132;
    let startX = 0, startY = 0, currentX = 0;
    let tracking = false, decided = false, horizontal = false;
    const bg = wrap.querySelector(".swipe-delete-bg");

    function reset(){
      card.style.transition = "transform .2s ease, opacity .2s ease";
      card.style.transform = "translateX(0)";
      card.style.opacity = "1";
      if (bg) bg.style.opacity = "0";
    }

    card.addEventListener("touchstart", function(e){
      if (e.touches.length !== 1) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      currentX = 0;
      tracking = true;
      decided = false;
      horizontal = false;
      card.style.transition = "none";
    }, {passive:true});

    card.addEventListener("touchmove", function(e){
      if (!tracking) return;
      const dx = e.touches[0].clientX - startX;
      const dy = e.touches[0].clientY - startY;
      if (!decided){
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        decided = true;
        horizontal = Math.abs(dx) > Math.abs(dy) * 1.3;
        if (!horizontal){ tracking = false; return; } // let the page scroll normally
      }
      if (!horizontal) return;
      e.preventDefault();
      currentX = Math.max(-maxDrag, Math.min(maxDrag, dx));
      card.style.transform = "translateX(" + currentX + "px)";
      const strength = Math.min(1, Math.abs(currentX) / threshold);
      card.style.opacity = String(1 - strength * 0.45);
      if (bg) bg.style.opacity = String(strength);
    }, {passive:false});

    function finish(){
      if (!tracking) return;
      tracking = false;
      if (horizontal && Math.abs(currentX) >= threshold){
        const dir = currentX > 0 ? 1 : -1;
        card.style.transition = "transform .18s ease, opacity .18s ease";
        card.style.transform = "translateX(" + (dir * 480) + "px)";
        card.style.opacity = "0";
        setTimeout(function(){ deleteAccountWithUndo(accountId); }, 170);
      } else {
        reset();
      }
    }
    card.addEventListener("touchend", finish);
    card.addEventListener("touchcancel", finish);
  }

