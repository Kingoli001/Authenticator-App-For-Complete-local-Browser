  async function tryNativeBarcodeDetector(img){
    if (!("BarcodeDetector" in window)) return null;
    try{
      if (typeof BarcodeDetector.getSupportedFormats === "function"){
        const supported = await BarcodeDetector.getSupportedFormats();
        if (supported && supported.indexOf("qr_code") === -1) return null;
      }
      const detector = new BarcodeDetector({ formats: ["qr_code"] });
      const results = await detector.detect(img);
      if (results && results.length > 0 && results[0].rawValue) return results[0].rawValue;
    } catch(e){ /* fall through to jsQR */ }
    return null;
  }

  function tryDecodeAtScale(img, targetLongSide){
    const naturalLong = Math.max(img.naturalWidth, img.naturalHeight);
    const scale = targetLongSide / naturalLong;
    const w = Math.max(1, Math.round(img.naturalWidth * scale));
    const h = Math.max(1, Math.round(img.naturalHeight * scale));
    scanCanvas.width = w;
    scanCanvas.height = h;
    const ctx = scanCanvas.getContext("2d");
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.drawImage(img, 0, 0, w, h);
    try{
      const imageData = ctx.getImageData(0, 0, w, h);
      if (typeof jsQR === "function"){
        return jsQR(imageData.data, w, h, { inversionAttempts: "attemptBoth" });
      }
    } catch(e){ /* fall through to null */ }
    return null;
  }

  async function processQrPhoto(file){
    scanStatus.hidden = true;
    const url = URL.createObjectURL(file);
    const img = new Image();

    img.onload = async function(){
      URL.revokeObjectURL(url);

      // 1) Prefer the browser/OS's own native QR engine when available —
      //    e.g. Google ML Kit on Android Chrome. Far more robust than any
      //    pure-JS decoder, and also handles native size directly (no
      //    manual canvas/scale juggling needed).
      const nativeResult = await tryNativeBarcodeDetector(img);
      if (nativeResult){
        handleScanResult(nativeResult);
        return;
      }

      // 2) Fall back to jsQR across a few sizes: native size (capped), then
      //    upscaled passes, since small/cropped photos decode more
      //    reliably once there are more pixels per QR module.
      const naturalLong = Math.max(img.naturalWidth, img.naturalHeight);
      const candidates = [
        Math.min(naturalLong, 1400),
        1400,
        2000
      ].filter(function(v, i, arr){ return arr.indexOf(v) === i; }); // dedupe

      let result = null;
      for (let i = 0; i < candidates.length && !result; i++){
        result = tryDecodeAtScale(img, candidates[i]);
      }

      if (result && result.data){
        handleScanResult(result.data);
      } else {
        scanStatus.hidden = false;
        scanStatus.textContent = "That photo didn't contain a readable TOTP QR code — try again with it centered, in focus, and filling more of the frame.";
      }
    };
    img.onerror = function(){
      URL.revokeObjectURL(url);
      scanStatus.hidden = false;
      scanStatus.textContent = "Couldn't read that photo — try again.";
    };
    img.src = url;
  }

  /* ---------- Live QR viewfinder scanning ---------- */
  let liveStream = null;
  let liveScanning = false;
  let liveRAF = null;
  let liveFacing = "environment";
  let liveDetector = null; // native BarcodeDetector instance, if available
