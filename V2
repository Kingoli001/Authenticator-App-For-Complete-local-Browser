  // A "wrap" is the 32-byte master key AES-GCM-encrypted under a key
  // derived (via PBKDF2) from some secret — either the PIN or the
  // recovery code. Two independent wraps of the same master key mean
  // either secret alone can unlock the vault.
  async function wrapMasterKey(masterKeyBytes, secretText){
    const salt = crypto.getRandomValues(new Uint8Array(16));
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const key = await deriveVaultKey(secretText, salt);
    const cipher = await crypto.subtle.encrypt({name:"AES-GCM", iv:iv}, key, masterKeyBytes);
    return { salt:bytesToB64(salt), iv:bytesToB64(iv), data:bytesToB64(new Uint8Array(cipher)) };
  }
  async function unwrapMasterKey(wrap, secretText){
    const salt = b64ToBytes(wrap.salt);
    const iv = b64ToBytes(wrap.iv);
