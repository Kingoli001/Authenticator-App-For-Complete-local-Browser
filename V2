    if (parsed.digits === "6" || parsed.digits === "8") digitsSelect.value = parsed.digits;
    if (parsed.period && parseInt(parsed.period, 10) > 0) periodInput.value = parsed.period;
    if (parsed.algorithm) {
      const a = String(parsed.algorithm).toUpperCase().replace(/^SHA(?=\d)/,"SHA-");
      if (["SHA-1","SHA-256","SHA-512"].includes(a)) algorithmSelect.value = a;
