  async function unlockOrSetup(pin){
    if (!/^\d{4,8}$/.test(pin)) throw new Error('PIN must contain 4–8 digits.');

    const stored = localStorage.getItem(PIN_HASH_KEY);

    // First-time PIN setup, an ordinary PIN change, or the final step of a
    // recovery-code-driven PIN reset all land here (enter -> confirm -> save).
    if (pinMode === 'setup') {
      if (pinSetupStep === 1) {
        firstSetupPin = pin;
        pinSetupStep = 2;
        unlockPin.value = '';
        lockTitle.textContent = 'Confirm your PIN';
        lockDescription.textContent = 'Enter the same PIN again to finish setup.';
        updateLockActionLabel();
        lockError.textContent = '';
        unlockPin.focus();
        return;
      }
      if (pin !== firstSetupPin) throw new Error('PINs do not match.');

      const changingExistingPin = !!window.__verifiedOldPin;
      const viaRecovery = !!window.__pendingRecoveryRotation;
      let newRecoveryCode = null;

      if (viaRecovery) {
        // Reset via recovery code: re-wrap with the new PIN AND rotate the
        // recovery code — the one just used should not remain valid.
        newRecoveryCode = await rewrapPinAndRotateRecovery(pin, accounts);
      } else if (changingExistingPin && window.__vaultMasterKey) {
        // Ordinary PIN change: same master key, same recovery code.
        await rewrapPin(pin, accounts);
      } else {
        // True first-time setup: brand-new vault, brand-new recovery code.
        newRecoveryCode = await createVault(pin, accounts);
      }

      localStorage.setItem(PIN_HASH_KEY, await sha256Hex(pin));
      window.__vaultPin = pin;
      window.__verifiedOldPin = '';
      window.__pendingRecoveryRotation = false;
      vaultUnlocked = true;
      pinMode = 'unlock';
      pinSetupStep = 0;
      setPinButtonState();
      hideLock();

      if (newRecoveryCode) {
        showRecoveryCodeScreen(newRecoveryCode, viaRecovery
          ? '✓ PIN RESET — new recovery code issued.'
          : '✓ PIN SET — vault encrypted.');
      } else {
        showListScreen();
        showToastSecurity('✓ PIN CHANGED — vault re-encrypted.');
      }
      return;
    }

    // Existing PIN must always be verified before changing or disabling it.
    if (!stored || (await sha256Hex(pin)) !== stored) throw new Error('Incorrect current PIN.');

    if (pinMode === 'verify-change') {
      // Current PIN verified; decrypt the existing vault (this also
      // populates window.__vaultMasterKey) before starting new-PIN setup.
      window.__pendingRecoveryRotation = false;
      if (hasEncryptedVault()) {
        accounts = await decryptAccountsFromVault(pin);
        window.__vaultPin = pin;
        renderAccountList();
      }
      window.__verifiedOldPin = pin;
      pinMode = 'setup';
      pinSetupStep = 1;
      firstSetupPin = '';
      unlockPin.value = '';
      lockTitle.textContent = 'Set new PIN';
      lockDescription.textContent = 'Choose a new 4–8 digit PIN. You will confirm it next.';
      updateLockActionLabel();
      lockError.textContent = '';
      unlockPin.focus();
      return;
    }

    if (pinMode === 'view-recovery') {
      // Regenerating invalidates the old recovery code permanently — confirm before proceeding.
      const okRegen = window.confirm('Generate a new recovery code? Your OLD recovery code will stop working immediately and cannot be recovered. Make sure you save the new one.');
      if (!okRegen) { pinMode = 'unlock'; hideLock(); openSettings(); return; }

      // Current PIN verified; make sure the master key is loaded (it
      // already will be if the app is unlocked, but re-decrypt to be safe
      // in case this was reached in an unusual state), then issue a fresh
      // recovery code and invalidate the old one.
      if (!window.__vaultMasterKey && hasEncryptedVault()) {
        accounts = await decryptAccountsFromVault(pin);
        window.__vaultPin = pin;
      }
      const newRecoveryCode = await regenerateRecoveryCode(accounts);
      pinMode = 'unlock';
      vaultUnlocked = true;
      setPinButtonState();
      hideLock();
      showRecoveryCodeScreen(newRecoveryCode, '✓ New recovery code generated — your old code no longer works.');
      return;
    }

    if (pinMode === 'verify-disable') {
      // Disabling the PIN also disables encrypted-at-rest storage. Make this explicit.
      const ok = window.confirm('Disable PIN and encrypted vault? Your accounts will remain on this browser, but will be stored without encryption. The recovery code will also stop working.');
      if (!ok) { pinMode = 'unlock'; hideLock(); openSettings(); return; }
      await decryptAccountsFromVault(pin).then(function(list){ accounts = list; });
      localStorage.setItem(ACCOUNTS_STORAGE_KEY, JSON.stringify(accounts));
      localStorage.removeItem(VAULT_STORAGE_KEY);
      localStorage.removeItem(PIN_HASH_KEY);
      localStorage.removeItem(PIN_ATTEMPTS_KEY);
      localStorage.setItem(AUTO_LOCK_KEY, '0');
      autoLockSelect.value = '0';
      window.__vaultPin = '';
      window.__vaultMasterKey = null;
      window.__vaultPinWrap = null;
      window.__vaultRecoveryWrap = null;
      vaultUnlocked = true;
      setPinButtonState();
      hideLock();
      showListScreen();
      showToastSecurity('✓ PIN DISABLED — vault unencrypted.');
      return;
    }

    // Normal unlock: decrypt the vault with the verified PIN before showing accounts.
    if (pinMode === 'unlock') {
      if (hasEncryptedVault()) {
        accounts = await decryptAccountsFromVault(pin);
        window.__vaultPin = pin;
        vaultUnlocked = true;
        renderAccountList();
      } else {
        // One-time migration from the older Phase 4 plaintext storage.
        // showLock() deliberately wipes the in-memory array, so read the legacy
        // copy directly from localStorage before replacing it with the vault.
        let legacyAccounts = [];
        try {
          const savedLegacy = localStorage.getItem(ACCOUNTS_STORAGE_KEY);
          const parsedLegacy = savedLegacy ? JSON.parse(savedLegacy) : [];
          legacyAccounts = Array.isArray(parsedLegacy) ? parsedLegacy : [];
        } catch(e) { legacyAccounts = []; }
        accounts = legacyAccounts;
        const recoveryCode = await createVault(pin, accounts);
        window.__pendingRecoveryCodeToShow = recoveryCode;
        window.__vaultPin = pin;
        vaultUnlocked = true;
      }
    }
    hideLock();
    if (window.__pendingRecoveryCodeToShow) {
      const code = window.__pendingRecoveryCodeToShow;
      window.__pendingRecoveryCodeToShow = null;
      showRecoveryCodeScreen(code, '✓ Vault upgraded — recovery code created.');
    } else {
      showListScreen();
    }
  }

