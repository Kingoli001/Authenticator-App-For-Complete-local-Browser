  async function setupBiometric(){
    if (!window.isSecureContext || !biometricSupported()) throw new Error('Biometric verification requires HTTPS/localhost and a browser with WebAuthn support.');
    const challenge = crypto.getRandomValues(new Uint8Array(32));
    const userId = crypto.getRandomValues(new Uint8Array(16));
    const credential = await navigator.credentials.create({ publicKey: {
      challenge,
      rp: { name: 'Authenticator' },
      user: { id: userId, name: 'local-authenticator', displayName: 'Authenticator' },
      pubKeyCredParams: [{type:'public-key',alg:-7},{type:'public-key',alg:-257}],
      authenticatorSelection: { residentKey:'preferred', userVerification:'required' },
      timeout: 60000,
      attestation: 'none'
    }});
    if (!credential) throw new Error('Biometric setup was cancelled.');
    localStorage.setItem(BIOMETRIC_CRED_KEY, btoa(String.fromCharCode(...new Uint8Array(credential.rawId))));
    updateBiometricUI();
    showToastSecurity('Biometric verification enabled.');
  }

  async function verifyBiometric(){
    if (!hasBiometric()) return true;
    if (!biometricSupported() || !window.isSecureContext) throw new Error('Biometric verification is unavailable in this browser.');
    const id = Uint8Array.from(atob(localStorage.getItem(BIOMETRIC_CRED_KEY)), c=>c.charCodeAt(0));
    const challenge = crypto.getRandomValues(new Uint8Array(32));
    const assertion = await navigator.credentials.get({ publicKey: {
      challenge,
      allowCredentials: [{ id, type:'public-key', transports:['internal'] }],
      userVerification: 'required',
      timeout: 60000
    }});
    if (!assertion) throw new Error('Biometric verification failed.');
    return true;
  }

